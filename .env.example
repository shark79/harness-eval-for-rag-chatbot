# Local extractive mode works without keys. Live Cloud mode requires a published Workflow.
RAG_MODE=extractive
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_APP_API_KEY=
DIFY_KNOWLEDGE_API_KEY=
DIFY_INPUT_NAME=ticket_text
DIFY_USER=local-ticket-assistant
DIFY_TIMEOUT=100
# decisions enables paid OpenAI scoring; offline results never claim semantic scores.
EVAL_MODE=offline
OPENAI_API_KEY=
PORT=8080
HOST=127.0.0.1
# For bind-mounted evaluation results, set these to id -u / id -g on your host.
LOCAL_UID=10001
LOCAL_GID=10001
