# Local extractive mode works without keys. Live Dify mode requires a published local Workflow.
RAG_MODE=extractive
DIFY_API_BASE_URL=http://localhost/v1
# Compose uses this URL because localhost inside its container is the ticket backend.
DIFY_DOCKER_API_BASE_URL=http://host.docker.internal/v1
DIFY_APP_API_KEY=
DIFY_KNOWLEDGE_API_KEY=
DIFY_INPUT_NAME=ticket_text
DIFY_USER=local-ticket-assistant
DIFY_TIMEOUT=100
# decisions enables paid OpenAI scoring; offline results never claim semantic scores.
EVAL_MODE=offline
OPENAI_API_KEY=
PORT=8080
HOST=127.0.0.1
# For bind-mounted evaluation results, set these to id -u / id -g on your host.
LOCAL_UID=10001
LOCAL_GID=10001
