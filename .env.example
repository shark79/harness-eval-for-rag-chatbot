# Export variables in your shell or let your application's configuration load .env.
# scripts/dify_api.py reads the process environment; it does not load this file.
DIFY_API_BASE_URL=https://api.dify.ai/v1
# App-scoped key from the app's API Access screen; required for live app commands.
DIFY_APP_API_KEY=
# Separate Knowledge Service API key; required for live knowledge commands.
DIFY_KNOWLEDGE_API_KEY=
# Stable, opaque end-user identifier; required for live generation commands.
DIFY_USER=
# Optional request timeout in seconds, >0 and <=600 (default 100).
DIFY_TIMEOUT=100
